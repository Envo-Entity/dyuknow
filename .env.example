# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Used by scripts/seed.mjs and scripts/wipe.mjs on a developer's machine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The one test password every fake @example.com login (and admin@dyuknow.com) gets.
SEED_PASSWORD=choose-a-test-password
